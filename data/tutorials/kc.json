	"report": [
		{
			"label": "Kc of FeSCN2+",
			"unit": "L/mol",
			"truth": "m3.iron_thiocyanate.mol * m3.condensed_ml / 1000 / ((m3.iron_iii_ion.mol + m3.iron_hydroxo_ion.mol) * m3.thiocyanate_ion.mol)",
			"tolerance": 0.12,
			"relative": true,
			"why": "In the notebook: x the iron as 1/, y the absorbance as 1/, fit: K = intercept / slope (Benesi and Hildebrand). Iron(III) in excess, its own amount is what is free; what it lends to its hydrolysis (FeOH2+) is counted with it, as the method does. Below, Connick and Coppel measured 146 in this medium (0.40 ionic strength, 0.1 M acid)."
		}
	],

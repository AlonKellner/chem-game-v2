# The renderer's key (Stage 86): one SHA-256 over the files a supply's picture is rendered by (the per-pixel source,
# the tracers, the scene's composition, colour, what lies in a vessel, the glassware, the core's optics and its tables),
# each by its name and its contents, so a picture built ahead is captured again once any of them changes, and is
# found again on every build of the same files.
#
#   cmake -DOUT=<header> -DNAMES=<a;b;...> -DFILES=<path;path;...> -P renderer_key.cmake
#
# NAMES are what each file is called in the key (relative to the repository, or a generated file's own name), FILES
# where each is read; the two lists in the same order. (The build runs it only once one of them has changed.)
list(LENGTH NAMES n)
list(LENGTH FILES m)
if(NOT n EQUAL m OR n EQUAL 0)
	message(FATAL_ERROR "renderer_key: ${n} names for ${m} files")
endif()
set(text "")
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
	list(GET NAMES ${i} name)
	list(GET FILES ${i} file)
	if(NOT EXISTS "${file}")
		message(FATAL_ERROR "renderer_key: ${file} does not exist")
	endif()
	file(SHA256 "${file}" sha)
	string(APPEND text "${name} ${sha}\n")
endforeach()
string(SHA256 key "${text}")
string(SUBSTRING "${key}" 0 16 key)
set(header "// Generated by native/cmake/renderer_key.cmake (Stage 86): the renderer's key, a hash of the ${n} files a supply's
// picture is rendered by. Do not edit.
#pragma once
namespace lab {
inline constexpr const char *RENDERER_KEY = \"${key}\";
inline constexpr int RENDERER_FILES = ${n};
} // namespace lab
")
file(WRITE "${OUT}" "${header}")

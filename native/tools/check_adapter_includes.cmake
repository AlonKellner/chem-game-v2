# ctest godot_adapter_includes: the Godot adapter (native/hosts/godot) knows the
# game through the C API alone -- every #include is chem_api.h, a godot-cpp
# header, a standard header, or the adapter's own.
# Run as: cmake -DCHEM_ADAPTER_DIR=<repo>/native/hosts/godot -P check_adapter_includes.cmake
if(NOT CHEM_ADAPTER_DIR)
    message(FATAL_ERROR "CHEM_ADAPTER_DIR not set")
endif()
file(GLOB_RECURSE files LIST_DIRECTORIES false "${CHEM_ADAPTER_DIR}/*.cpp" "${CHEM_ADAPTER_DIR}/*.hpp" "${CHEM_ADAPTER_DIR}/*.h")
file(GLOB own RELATIVE "${CHEM_ADAPTER_DIR}" "${CHEM_ADAPTER_DIR}/*.hpp" "${CHEM_ADAPTER_DIR}/*.h")
set(offenders "")
foreach(f IN LISTS files)
    file(STRINGS "${f}" includes REGEX "^[ \t]*#[ \t]*include")
    foreach(line IN LISTS includes)
        string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*" "" inc "${line}")
        string(REGEX MATCH "^[<\"][^>\"]*[>\"]" inc "${inc}")
        string(REGEX REPLACE "^[<\"](.*)[>\"]$" "\\1" name "${inc}")
        set(ok FALSE)
        if(name STREQUAL "chem_api.h" OR name MATCHES "^godot_cpp/" OR (inc MATCHES "^<" AND name MATCHES "^[a-z_]+$"))
            set(ok TRUE)
        endif()
        list(FIND own "${name}" i)
        if(NOT i EQUAL -1)
            set(ok TRUE)
        endif()
        if(NOT ok)
            list(APPEND offenders "${f}: ${inc}")
        endif()
    endforeach()
endforeach()
list(LENGTH files n)
if(offenders)
    list(JOIN offenders "\n  " joined)
    message(FATAL_ERROR "the Godot adapter must include only chem_api.h (and godot-cpp, the standard library, its own headers):\n  ${joined}")
endif()
message(STATUS "godot_adapter_includes: ${n} files under ${CHEM_ADAPTER_DIR} reach the game through chem_api.h alone")
